# Edge agent runtime config (copy to /etc/friend-drone/edge-agent.env).
# Keep this file readable only by root/service account in production.

INPUT_MODE=mavlink-uart
TARGET=bridge
INGEST_URL=https://bridge.local/bridge/v1/telemetry/ingest

DRONE_UID=DRN-REAL-001
DEVICE_ID=JETSON-REAL-001
SHARED_SECRET=replace-me-with-drone-shared-secret
BRIDGE_TOKEN=replace-me-with-bridge-token

RATE_HZ=1.0
SPOOL_DB_PATH=/var/lib/friend-drone/edge_agent_spool.db
TIMEOUT_SECONDS=3.0

RETRY_MAX_ATTEMPTS=8
RETRY_BACKOFF_SECONDS=1.0
RETRY_BACKOFF_MAX_SECONDS=30.0
QUEUE_MAX=10000
FLUSH_BATCH_SIZE=25
LOG_EVERY=20

# MAVLink input
MAVLINK_DEVICE=/dev/ttyTHS1
MAVLINK_BAUD=57600

# UDP fallback input
UDP_HOST=0.0.0.0
UDP_PORT=15000

# TLS/mTLS notes:
# For strict TLS with custom CA, put --tls-ca-file in service ExecStart manually
# or create a second service file variant for your environment.
# For mTLS, also provide --tls-client-cert-file and --tls-client-key-file.

