# Copy this file to ".env" and rotate secrets before shared/demo usage.
# Windows: Copy-Item .env.example .env
# Linux/macOS: cp .env.example .env

APP_NAME=Friend Drone MVP
ENVIRONMENT=dev

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/friend_drone
REDIS_URL=redis://redis:6379/0

# Required secrets for API
JWT_SECRET_KEY=***REMOVED***
MASTER_KEY=***REMOVED***
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
ACCESS_COOKIE_NAME=fd_access_token
CSRF_COOKIE_NAME=fd_csrf_token
SECURE_COOKIES=false
SESSION_MAX_AGE_SECONDS=7200
TELEMETRY_ALLOWED_SKEW_SECONDS=30
NONCE_TTL_SECONDS=120
RETENTION_DAYS=30
LINK_LOST_SECONDS=10
CORS_ORIGINS=["*"]

# Decision-maker presentation demo mode
DEMO_MODE_ENABLED=true
DEMO_INTERCEPTOR_SPEED_MPS=95
DEMO_INTERCEPTOR_MIN_DURATION_SECONDS=25

# Map provider:
# - openfreemap: dünya genelinde yüksek zoom ve Türkçe etiket önceliği için online/vector basemap
# - offline: projedeki yerel raster tile paketlerini kullanır
MAP_PROVIDER=openfreemap
MAP_LABEL_LANGUAGE=tr
MAP_HIDDEN_LABELS=Kürdistan Bölgesel Yönetimi,Kürdistan,Kurdistan Region,Kurdistan Regional Government,Kurdistan
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_HOME_LAT=39.0
MAP_HOME_LON=35.2
MAP_HOME_ZOOM=5.4
MAP_MIN_ZOOM=2
MAP_MAX_ZOOM=19
MAPLIBRE_CSS_URL=https://unpkg.com/maplibre-gl/dist/maplibre-gl.css
MAPLIBRE_JS_URL=https://unpkg.com/maplibre-gl/dist/maplibre-gl.js
MAPLIBRE_LEAFLET_JS_URL=https://unpkg.com/@maplibre/maplibre-gl-leaflet/leaflet-maplibre-gl.js

# Civil air traffic overlay (OpenSky)
OPENSKY_ENABLED=true
OPENSKY_BBOX=34.0,18.0,45.5,45.5
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_CACHE_TTL_SECONDS=30
OPENSKY_TIMEOUT_SECONDS=6
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Required secret for Bridge ingress
BRIDGE_PORT=8100
BRIDGE_SOURCE_TOKEN=***REMOVED***
BRIDGE_API_INGEST_URL=http://api:8000/v1/telemetry/ingest
BRIDGE_FORWARD_TIMEOUT_SECONDS=2
BRIDGE_RETRY_MAX_ATTEMPTS=5
BRIDGE_RETRY_BACKOFF_SECONDS=1
BRIDGE_QUEUE_KEY=bridge:telemetry:retry
BRIDGE_DLQ_KEY=bridge:telemetry:dlq
BRIDGE_QUEUE_MAX=10000

# Optional Postgres service vars used by docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=friend_drone
